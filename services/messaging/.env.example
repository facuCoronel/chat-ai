WEBHOOK_VERIFY_TOKEN=your-secret-verify-token-here
APP_SECRET=your-meta-app-secret-here
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/your-database
LOG_LEVEL=INFO

# Ollama — required, configure in Railway environment variables
OLLAMA_BASE_URL=http://ollama-production-6323.up.railway.app
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_PROMPT_VERSION=v1

# Whisper transcription - required; API key is optional
WHISPER_BASE_URL=http://whisper-production.up.railway.app
WHISPER_API_KEY=
